[Unit]
Description=Iva memory rollup (yearly)
After=network-online.target iva.service

[Service]
# Everything these units create (vault, transcripts, data/) must not be world-readable.
UMask=0077
Type=oneshot
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Один флок на все memory-юниты: роллапы и doctor пишут CORE.md/MOC.md — параллельный
# запуск (1 января стартуют все четыре) не должен переписывать их одновременно.
# Страховка от молчаливого зависания хода (#104): убитый по таймауту юнит становится
# failed и виден в `iva doctor`, вместо ночи, которая висит до утра.
# 3600 = запас на flock-очередь (до 900с) + таймаут зависшего хода (600с) + retry (600с).
RuntimeMaxSec=3600
ExecStart=/usr/bin/flock -w 900 __PROJECT_DIR__/.memory.lock __NODE_BIN__ --env-file=.env scripts/memory/rollup.ts yearly
